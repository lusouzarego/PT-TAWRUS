# Token do bot (fale com @BotFather no Telegram → /newbot)
TELEGRAM_BOT_TOKEN=123456:ABC...
# Seu chat id (mande /start pro bot depois do deploy, ele responde com o número)
TELEGRAM_CHAT_ID=
# URL pública do deploy (ex.: https://pt-tawrus.vercel.app) — usada pelo Mini App e pelas imagens
APP_URL=
# Segredo qualquer: a Vercel envia no header Authorization do cron
CRON_SECRET=
# Segredo qualquer: o Telegram envia no header do webhook
TELEGRAM_WEBHOOK_SECRET=
