# Obrigatórias na Vercel (Settings → Environment Variables):

# Token do bot (fale com @BotFather no Telegram → /newbot)
TELEGRAM_BOT_TOKEN=
# Uma senha longa que você inventa. A Vercel usa no envio das 5h e ela protege o /api/setup
CRON_SECRET=

# Depois do /start (o bot responde com o número):
TELEGRAM_CHAT_ID=

# Opcionais
# URL pública. Se vazio, usa o domínio de produção da Vercel automaticamente
APP_URL=
# Se vazio, é derivado do token do bot
TELEGRAM_WEBHOOK_SECRET=

# Assinatura (valores só na Vercel; o repositório é público)
PRECO_MENSAL=€9,90
PAGAMENTO_SATISPAY=
PAGAMENTO_IBAN=
PAGAMENTO_TITULAR=
# Criadas automaticamente pelo Upstash Redis (Vercel → Storage)
KV_REST_API_URL=
KV_REST_API_TOKEN=
